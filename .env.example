# ------------------------------------------------------------------
#  ANT COLONY — configuration
#  Vercel: Project > Settings > Environment Variables. Locally: copy to .env
#  Leave TOKEN_MINT empty to run the demo colony.
# ------------------------------------------------------------------

# --- Token -----------------------------------------------------------
# The coin must be launched on pump.fun with Holder Rewards ("Holders") turned on.
# The rewards vault and the reward asset (SOL or the pair token) are found automatically.
TOKEN_MINT=
TOKEN_NAME=Ant Colony
TOKEN_SYMBOL=ANTS

# Optional links shown in the header
LINK_X=
LINK_TELEGRAM=

# --- Solana (read-only) ------------------------------------------------
# A Helius RPC is recommended: the holder scan uses its getTokenAccounts method.
# The public RPC blocks holder scans.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# "das" (Helius), "gpa" (getProgramAccounts) or "auto"
HOLDER_SOURCE=auto

# Optional overrides for the reward asset (normally detected from the vault)
REWARD_MINT=
REWARD_SYMBOL=

# --- Storage (Vercel) --------------------------------------------------
# Added automatically when you connect "Upstash for Redis" from the Vercel Marketplace.
# Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: protects /api/sync when you add a Vercel Cron Job (Pro plan)
CRON_SECRET=

# --- Display ---------------------------------------------------------
# Wallets to show as grey "excluded" ants (dev, team, CEX...). Comma separated.
EXCLUDE_WALLETS=
# pump.fun's eligibility threshold in US$ (used for the estimates)
MIN_ELIGIBLE_USD=20
# How many holders are sent to the 3D scene (largest first)
PUBLIC_HOLDER_LIMIT=1500
